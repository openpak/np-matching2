# np-matching2 (PS3 Matching2 agent). Copy next to the quadlet; never commit real values.
NP_HTTP_ADDR=:8538
NP_PLAIN_ADDR=:3480
NP_TLS_ADDR=:8443
NP_DATABASE_URL=postgres://np_matching2:change-me@openpak-postgres/np_matching2?sslmode=disable
NP_CORE_ADDR=openpak-account:20001
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!
NP_TICKET_KEY=/run/ps3/np-ticket-key.pem
NP_TLS_CA_CERT=/run/ps3/ps3-ca.pem
NP_TLS_CA_KEY=/run/ps3/ps3-ca.key
# The agent host the firmware is given in the room-server list (0x1209/0x2001) and the CN/SAN of the no-SNI TLS leaf.
# Production: the box IP, same as np-community NP_MATCHING_AGENT. vsh checks the leaf CN against this host (the part
# after the first dot), so the leaf must carry the IP; a real PS3 does not resolve the hostname through the DNS catcher.
# A hello with SNI matching.np.community.playstation.net (the testclient) still reaches the agent.
NP_MATCHING_HOST=145.241.199.19
NP_MATCHMAKING_ADDR=openpak-matchmaking:20251
NP_MATCHMAKING_KEY=change-me
# Cross-play is always on (PS3 search lists Wii U rooms of the same group). Incident kill switch only: set to 1 to list np rooms alone.
NP_MATCHING_CROSSPLAY_OFF=
# {"NPWR04270_00": {"title": "terraria", "passphrase": "<256 hex chars>"}, "NPWR05636_00": {"title": "minecraft", "passphrase": "<256 hex chars>"}}
# Optional per title: "compat" (room compatibility group: Terraria old-gen-1.2.4, minecraft lce-ps3-0884) and "status" (the 0x1001 server status byte: Terraria 0, minecraft 1).
# NP_MATCHING_ROOM_EVENTS=1 pushes room events (MemberJoined, UpdatedRoomDataInternal, UpdatedRoomMemberDataInternal) to the members' connections.
NP_MATCHING_TITLES=/run/ps3/matching-titles.json
# The old no-SNI path (Diablo II Resurrected game server): TLS 1.2 terminated here, plaintext to the target.
NP_NOSNI_CERT=/run/ps3/battlenet.pem
NP_NOSNI_KEY=/run/ps3/battlenet.key
NP_NOSNI_TARGET=openpak-battlenet:21503
ACCOUNT_ERASE_KEY=change-me
